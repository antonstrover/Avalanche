{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/antonstrover/Avalanche/artifacts/monitor/attempt-lock-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "attempt_name",
    "model_kind",
    "information_profile",
    "candidate_name",
    "feature_names",
    "normalization",
    "training_diagnostics",
    "model_filename",
    "model_sha256",
    "calibration_filename",
    "calibration_sha256",
    "threshold_filename",
    "threshold_sha256",
    "dataset_sha256",
    "split_manifest_sha256",
    "feature_schema_sha256",
    "training_configuration_sha256",
    "shortcut_report_sha256",
    "candidate_registry_sha256",
    "development_manifest_sha256",
    "dataset_release_lock_sha256",
    "dataset_manifest_sha256",
    "master_feature_registry_sha256",
    "profile_feature_registry_sha256",
    "label_schema_sha256",
    "calibration_protocol_sha256",
    "certified_runtime_sha256",
    "epoch_sampler_occurrence_sha256",
    "execution_journal_url",
    "execution_journal_sha256",
    "compatibility",
    "assets",
    "release_id",
    "release_tag",
    "release_api_url",
    "source_code_revision",
    "gate_name",
    "gate_thresholds",
    "gate_passed",
    "gate_margins",
    "creation_command",
    "schema_versions",
    "release_url"
  ],
  "properties": {
    "lock_version": {"const": 3},
    "attempt_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*$"},
    "model_kind": {"enum": ["perceptron", "gru"]},
    "information_profile": {"$ref": "#/$defs/profile"},
    "candidate_name": {"$ref": "#/$defs/candidate"},
    "feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "normalization": {"$ref": "#/$defs/normalization"},
    "training_diagnostics": {"$ref": "#/$defs/training_diagnostics"},
    "model_filename": {"const": "model.pt"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_filename": {"const": "calibration.json"},
    "calibration_sha256": {"$ref": "#/$defs/sha256"},
    "threshold_filename": {"const": "threshold.json"},
    "threshold_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "feature_schema_sha256": {"$ref": "#/$defs/sha256"},
    "training_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "shortcut_report_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_registry_sha256": {"$ref": "#/$defs/sha256"},
    "development_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_release_lock_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "master_feature_registry_sha256": {"$ref": "#/$defs/sha256"},
    "profile_feature_registry_sha256": {"$ref": "#/$defs/sha256"},
    "label_schema_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_protocol_sha256": {"$ref": "#/$defs/sha256"},
    "certified_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "epoch_sampler_occurrence_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "execution_journal_url": {"type": "string", "format": "uri"},
    "execution_journal_sha256": {"$ref": "#/$defs/sha256"},
    "compatibility": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/compatibility"}},
    "assets": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/asset"}},
    "release_id": {"type": "string", "minLength": 1},
    "release_tag": {"type": "string", "minLength": 1},
    "release_api_url": {"type": "string", "format": "uri"},
    "source_code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate_name": {"const": "sleeper-recall-at-episode-false-alarm-budget"},
    "gate_thresholds": {"type": "object", "additionalProperties": false, "required": ["false_alarm_budget", "sleeper_recall"], "properties": {"false_alarm_budget": {"const": 0.05}, "sleeper_recall": {"const": 0.8}}},
    "gate_passed": {"type": "boolean"},
    "gate_margins": {"type": "object", "additionalProperties": false, "required": ["false_alarm_budget", "sleeper_recall"], "properties": {"false_alarm_budget": {"type": "number"}, "sleeper_recall": {"type": "number"}}},
    "creation_command": {"type": "string", "minLength": 1},
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration", "dataset", "feature", "label", "lock", "model", "shortcut_report"],
      "properties": {
        "calibration": {"const": 2},
        "dataset": {"const": 5},
        "feature": {"const": 3},
        "label": {"const": 2},
        "lock": {"const": 3},
        "model": {"const": 2},
        "shortcut_report": {"const": 3}
      }
    },
    "release_url": {"type": "string", "format": "uri"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"enum": ["principal-full", "proposal-only", "operational-state-only", "operational-context-only", "no-history"]},
    "candidate": {"enum": ["mlp-64x32-paired-v4", "mlp-128x64-paired-v4", "gru32-window8-paired-v4"]},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit_split", "statistic_dtype", "output_dtype", "ddof", "deviation_floor", "floor_replacement", "mean", "variance", "deviation"],
      "properties": {
        "fit_split": {"const": "training_roots"},
        "statistic_dtype": {"const": "float64"},
        "output_dtype": {"const": "float32"},
        "ddof": {"const": 0},
        "deviation_floor": {"const": 0.00000001},
        "floor_replacement": {"const": 1.0},
        "mean": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "variance": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "deviation": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "training_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_training_loss", "best_training_loss", "optimizer_update_count", "batch_counts"],
      "properties": {
        "final_training_loss": {"type": "number", "minimum": 0},
        "best_training_loss": {"type": "number", "minimum": 0},
        "optimizer_update_count": {"type": "integer", "minimum": 1},
        "batch_counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_sha256", "expected_logit_hex"],
      "properties": {
        "name": {"enum": ["all-zero", "repeating-minus-one-zero-one"]},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "expected_logit_hex": {"type": "string", "pattern": "^[0-9a-f]{8}$"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256"],
      "properties": {
        "name": {"enum": ["model.pt", "calibration.json", "threshold.json", "execution-journal-v1.jsonl"]},
        "url": {"type": "string", "format": "uri"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
